# ---------------------------------------------------------------------------
# OpsFlow ERP - root environment template
# Individual .env files live inside frontend/ and backend/ (see their folders).
# ---------------------------------------------------------------------------

# --- Backend (copy to backend/.env) ---------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/opsflow"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=5000
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"

# --- Frontend (copy to frontend/.env.local) -------------------------------
VITE_API_URL="http://localhost:5000/api"