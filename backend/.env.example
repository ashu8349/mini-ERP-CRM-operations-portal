# ---------------------------------------------------------------------------
# OpsFlow ERP - Server environment (EXAMPLE)
# Copy this file to `.env` and fill in your real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon/Supabase/local)
DATABASE_URL="postgresql://user:password@host:5432/opsflow?sslmode=require"

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"

# How long a JWT stays valid (e.g. 7d, 8h)
JWT_EXPIRES_IN="7d"

# Port for the API server
PORT=5000

# Allowed frontend origin(s) - comma separated for multiple
CLIENT_URL="http://localhost:5173"

# production | development | test
NODE_ENV="development"